FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
ENV HUSKY=0 NEXT_TELEMETRY_DISABLED=1
RUN npm ci --no-audit --no-fund
COPY . .
RUN test ! -e vercel.json && test ! -e netlify.toml && test ! -e .github/workflows/deploy.yml
RUN grep -Fx 'Hosting: Cloudflare only. Never Vercel or Netlify.' AGENTS.md
RUN npm run typecheck
RUN npm run build:cloudflare
RUN test -s .open-next/worker.js && test -d .open-next/assets/_next/static
